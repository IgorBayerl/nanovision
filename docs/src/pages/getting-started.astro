---
import Layout from '../layouts/Layout.astro'
import { Terminal, AlertTriangle, FileText, Play, Download, ArrowLeft } from 'lucide-react'
import CopyCode from '../components/CopyCode.jsx'
---

<Layout title="Nanovision | Getting Started">
  <main class="pt-24 pb-16 min-h-screen bg-background">
    <div class="max-w-7xl mx-auto px-6">
      <!-- Page heading -->
      <div class="mb-6">
        <h1 class="text-4xl md:text-5xl font-bold text-foreground mb-4 tracking-tight">Getting Started</h1>
        <p class="text-xl text-muted-foreground max-w-2xl">
          Install Nanovision and generate your first coverage report.
        </p>
      </div>

      <!-- Unified step alert (backward: previous step is About Coverage) -->
      <div
        class="mb-10 bg-primary/5 border border-primary/30 rounded-xl p-4 md:p-5 flex flex-col md:flex-row items-center justify-between gap-4"
      >
        <div class="text-left">
          <p class="text-sm font-semibold text-primary mb-1">New to coverage?</p>
          <p class="text-sm text-muted-foreground">
            If you are new to code coverage, it is often worth taking a step back and reading
            <span class="font-medium text-foreground"> About Coverage</span> first.
          </p>
        </div>
        <a
          href={`${import.meta.env.BASE_URL}about-coverage`}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-primary-foreground text-sm font-semibold hover:opacity-90 transition-colors whitespace-nowrap"
        >
          Back to About Coverage
          <ArrowLeft size={16} />
        </a>
      </div>

      <div class="space-y-12">
        <!-- Disclaimer -->
        <div class="bg-amber-500/10 border border-amber-500/20 rounded-xl p-6 flex items-start gap-4">
          <AlertTriangle className="text-amber-500 shrink-0 mt-1" size={24} />
          <div class="space-y-2">
            <h3 class="text-lg font-bold text-amber-500">Prerequisite: Generate Coverage First</h3>
            <p class="text-muted-foreground">
              Nanovision is an analysis tool. You must generate coverage files (like
              <code> lcov.info</code>, <code>cobertura.xml</code>, or <code>coverage.out</code>) using your language's
              standard testing tools first.
            </p>
          </div>
        </div>
        <!-- Installation -->
        <section class="space-y-4">
          <h2 class="text-2xl font-semibold text-foreground flex items-center gap-2">
            <Download className="text-primary" />
            Installation
          </h2>
          <p class="text-muted-foreground">
            Nanovision is distributed as a single binary. Choose the installation method for your platform.
          </p>

          <div class="grid md:grid-cols-2 gap-6">
            <!-- Windows -->
            <div class="bg-card border border-border rounded-xl p-6 space-y-3">
              <h3 class="text-lg font-semibold text-foreground">Windows (winget)</h3>
              <p class="text-sm text-muted-foreground">Install Nanovision using the Windows Package Manager:</p>
              <CopyCode client:load code="winget install nanovision" singleLine />
            </div>

            <!-- Linux -->
            <div class="bg-card border border-border rounded-xl p-6 space-y-3">
              <h3 class="text-lg font-semibold text-foreground">Linux (install script)</h3>
              <p class="text-sm text-muted-foreground">
                Use the official install script to download and place the binary:
              </p>
              <CopyCode
                client:load
                code="curl -sL https://raw.githubusercontent.com/IgorBayerl/nanovision/main/scripts/install.sh | bash"
                singleLine
              />
              <p class="text-xs text-muted-foreground">
                This script downloads the latest release and installs it on your system.
              </p>
            </div>
          </div>

          <div class="bg-secondary/20 border border-border rounded-xl p-4 text-sm text-muted-foreground">
            Prefer manual installation? Download the binaries for Windows or Linux from the
            <a
              href="https://github.com/IgorBayerl/nanovision/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline"
            >
              Releases page
            </a>
            and add the binary to your <code>PATH</code>.
          </div>
        </section>

        <!-- Quickstart -->
        <section class="space-y-4">
          <h2 class="text-2xl font-semibold text-foreground flex items-center gap-2">
            <Terminal className="text-primary" />
            Quickstart: First Report
          </h2>
          <p class="text-muted-foreground">
            Once you have coverage files and Nanovision installed, the simplest command is:
          </p>
          <CopyCode client:load code="nanovision -report coverage.out -sourcedirs ." singleLine />
          <p class="text-muted-foreground text-sm">
            This reads <code>coverage.out</code>, scans the current directory for source files, and writes an HTML
            report to the default output directory (typically <code>coverage-report</code>).
          </p>
        </section>

        <!-- Inputs & Configuration -->
        <section>
          <h2 class="text-2xl font-semibold text-foreground flex items-center gap-2 mb-4">
            <FileText className="text-primary" />
            Inputs &amp; Configuration
          </h2>
          <p class="text-muted-foreground mb-6">
            Nanovision is flexible. You can pass arguments directly via the CLI or use a YAML configuration file for
            more complex setups.
          </p>

          <div class="grid md:grid-cols-2 gap-8">
            <!-- CLI Arguments -->
            <div class="space-y-4">
              <h3 class="text-lg font-semibold text-foreground">CLI Arguments</h3>
              <p class="text-sm text-muted-foreground mb-2">
                These are the flags for basic usage. For the full set of options, advanced features, and CI generators,
                use the
                <a href={`${import.meta.env.BASE_URL}configurator`} class="text-primary hover:underline ml-1">
                  Configurator
                </a>.
              </p>

              <div class="bg-card border border-border rounded-xl overflow-hidden">
                <div class="p-4 border-b border-border bg-muted/30">
                  <code class="text-sm font-mono text-primary">nanovision [flags]</code>
                </div>
                <div class="p-6 space-y-4 text-sm font-mono">
                  <div>
                    <span class="text-foreground font-bold">-report</span>
                    <span class="text-muted-foreground"> (string)</span>
                    <p class="text-muted-foreground mt-1 pl-4 border-l-2 border-border">
                      Path to the coverage file (e.g., <code>coverage.out</code>, <code>lcov.info</code>).
                    </p>
                  </div>
                  <div>
                    <span class="text-foreground font-bold">-sourcedirs</span>
                    <span class="text-muted-foreground"> (string)</span>
                    <p class="text-muted-foreground mt-1 pl-4 border-l-2 border-border">
                      Comma-separated paths to source code directories.
                    </p>
                  </div>
                  <div>
                    <span class="text-foreground font-bold">-output</span>
                    <span class="text-muted-foreground"> (string)</span>
                    <p class="text-muted-foreground mt-1 pl-4 border-l-2 border-border">
                      Directory where the report will be written (for example <code>coverage-report</code>).
                    </p>
                  </div>
                  <div>
                    <span class="text-foreground font-bold">-conf</span>
                    <span class="text-muted-foreground"> (string)</span>
                    <p class="text-muted-foreground mt-1 pl-4 border-l-2 border-border">
                      Path to a specific config file (default: <code>nanovision.yaml</code> in the current directory).
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- YAML Config -->
            <div class="space-y-4">
              <h3 class="text-lg font-semibold text-foreground">Configuration File</h3>
              <p class="text-sm text-muted-foreground">
                For repeatable setups it is recommended to use a <code>nanovision.yaml</code> file. You can also
                <a href={`${import.meta.env.BASE_URL}configurator`} class="text-primary hover:underline">
                  generate this file with the Configurator
                </a>.
              </p>
              <CopyCode
                client:load
                code={`reports:
  - "coverage.out"

source_dirs:
  - "."

output_dir: "coverage-report"

report_types:
  - "Html"
  - "TextSummary"`}
              />
            </div>
          </div>

          <p class="text-muted-foreground mt-4 text-sm">
            When a <code>nanovision.yaml</code> file is present in the current directory, you can simply run
            <code> nanovision</code> with no arguments and the configuration will be picked up automatically.
          </p>
        </section>

        <!-- CI/CD Integration -->
        <section class="space-y-4">
          <h2 class="text-2xl font-semibold text-foreground flex items-center gap-2">
            <Play className="text-primary" />
            CI/CD Integration
          </h2>
          <p class="text-muted-foreground">
            Nanovision is designed to run in your CI pipeline after your tests complete and coverage files are written.
            It returns a non-zero exit code if coverage thresholds are not met, so you can fail the build when coverage
            drops below your standards.
          </p>
          <p class="text-muted-foreground text-sm">
            For complex setups (multiple inputs, filters, thresholds, and GitHub Actions workflows), use the
            <a href={`${import.meta.env.BASE_URL}configurator`} class="text-primary hover:underline"> Configurator </a>
            to generate ready-to-use commands and config files.
          </p>
        </section>
      </div>

      <div class="mt-16 p-6 bg-secondary/20 rounded-xl border border-border">
        <h3 class="text-lg font-bold text-foreground mb-2">Need a configuration file or CI workflow?</h3>
        <p class="text-muted-foreground mb-4">
          Use the interactive configurator to generate a CLI command, <code>nanovision.yaml</code>, or GitHub Actions
          workflow tailored to your project.
        </p>
        <a
          href={`${import.meta.env.BASE_URL}configurator`}
          class="inline-block bg-primary text-primary-foreground px-4 py-2 rounded-md font-medium hover:opacity-90"
        >
          Open Configurator
        </a>
      </div>
    </div>
  </main>
</Layout>
