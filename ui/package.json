{
    "name": "ui",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --config vite.config.modern.ts",
        "build": "vite build --config vite.config.index.ts && vite build --config vite.config.details.ts",
        "build:modern": "vite build --config vite.config.modern.ts",
