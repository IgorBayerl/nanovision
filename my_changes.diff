+				// Check offsets are correct (should be 0, 1, 2 for consecutive additions)
+				want := []int{0, 1, 2}
+				if !reflect.DeepEqual(h.AddedLineOffsets, want) {
+					t.Errorf("added line offsets = %v, want %v", h.AddedLineOffsets, want)
