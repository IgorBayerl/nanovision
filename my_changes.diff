+func TestReverseNumber(t *testing.T) {
+	testCases := []struct {
+		input    int
+		expected int
+	}{
+		{123, 321},
+		{1000, 1},
+		{1, 1},
+		{1234567, 7654321},
+	}
+
+	for _, tc := range testCases {
+		t.Run("", func(t *testing.T) {
+			if got := ReverseNumber(tc.input); got != tc.expected {
+				t.Errorf("ReverseNumber(%d) = %d; want %d", tc.input, got, tc.expected)
+			}
+		})
+	}
+}
